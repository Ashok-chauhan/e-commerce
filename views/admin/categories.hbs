<h2>Manage Categories</h2>
<div class="row">
  <div class="col-md-3">
<form method="POST" action="/admin/categories" enctype="multipart/form-data">
   <div class="form-group">
      <input type="text" name="name" placeholder="New Category" required />
  </div>
  <div class="form-group">
     <input type="file" class="form-control" id="image" name="image" >
  </div>
  <div class="form-group">
    <button type="submit">Add</button>
  </div>
</form>
</div>
</div>


<table class="table">
   {{#each categories}}
    <tr><td>{{this.id}}</td><td>{{this.name}}</td><td><img src="/assets/images/{{this.image}}" class="img-thumbnail" style="width:200px;" /></td>
   <td><a href="/admin/categoryEdit/{{this.id}}"><button class="btn btn-primary btn-sm">Edit</button></a></td>
    
    </tr>
  {{/each}}

</table>
