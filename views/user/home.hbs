  {{#each products}}
 
{{!-- class="card-img-top" --}}
  <div class="col-md-2  p-1">
    <a href="/product/{{this.slug}}">
       <img src="/assets/images/{{this.image}}" class="picture" alt="{{this.name}}">
       </a>
      {{!-- <div class="card-body"> --}}
        <h5 class=" title p-1">{{this.name}}</h5>
       
    {{#if this.discount_percent}}
      <p>
        <span class="original-price">M.R.P ₹{{this.price}}</span>
        <span class="discount">(-{{this.discount_percent}}% off)</span>
      </p>
      <p class="final-price">₹{{this.discounted_price}}</p>
    {{else}}
      <p class="final-price">₹{{this.price}}</p>
    {{/if}}

        <h6 class="description">{{{this.short_description}}}</h6>
        <a href="/product/{{this.slug}}" class="btn btn-warning btn-sm"  style="--bs-btn-padding-y: .25rem; --bs-btn-padding-x: .5rem; --bs-btn-font-size: .75rem;">Add to cart</a>
      {{!-- </div> --}}
    
 </div>

  {{/each}}
